# odin-gdk-pixbuf: its place in the binding graph
# Render:  d2 diags/odin-gdk-pixbuf.d2 diags/odin-gdk-pixbuf.svg

direction: down

title: "odin-gdk-pixbuf" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-gdk-pixbuf\ngdk-pixbuf 2.42.10" {
  style.fill: "#eef6ff"
}
lib: "gdk-pixbuf-2.0 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"pixbuf:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection pixbuf
this -> lib: foreign import
